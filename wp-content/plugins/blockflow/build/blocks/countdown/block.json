{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockflow/countdown",
  "version": "1.0.0",
  "title": "Countdown",
  "category": "blockflow",
  "description": "Display a countdown timer to a specific date and time.",
  "keywords": [
    "countdown",
    "timer",
    "date",
    "time",
    "event"
  ],
  "textdomain": "blockflow",
  "attributes": {
    "blockId": {
      "type": "string"
    },
    "endDate": {
      "type": "string",
      "default": ""
    },
    "showDays": {
      "type": "boolean",
      "default": true
    },
    "showHours": {
      "type": "boolean",
      "default": true
    },
    "showMinutes": {
      "type": "boolean",
      "default": true
    },
    "showSeconds": {
      "type": "boolean",
      "default": true
    },
    "ariaLive": {
      "type": "string",
      "default": "off",
      "enum": [
        "off",
        "polite",
        "assertive"
      ]
    },
    "separator": {
      "type": "object",
      "default": {
        "type": "colon",
        "custom": ""
      }
    },
    "labels": {
      "type": "object",
      "default": {
        "show": true,
        "position": "below",
        "days": "Days",
        "day": "Day",
        "hours": "Hours",
        "hour": "Hour",
        "minutes": "Minutes",
        "minute": "Minute",
        "seconds": "Seconds",
        "second": "Second",
        "custom": {
          "days": true,
          "hours": true,
          "minutes": true,
          "seconds": true
        }
      }
    },
    "expiredAction": {
      "type": "object",
      "default": {
        "type": "hide",
        "message": ""
      }
    },
    "alignment": {
      "type": "object",
      "default": {
        "desktop": "center",
        "tablet": "",
        "mobile": ""
      }
    },
    "itemGap": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "12",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "digitTypography": {
      "type": "object",
      "default": {
        "desktop": {
          "fontFamily": "",
          "fontSize": {
            "value": "40",
            "unit": "px"
          },
          "fontWeight": "700",
          "textTransform": "",
          "fontStyle": "",
          "lineHeight": {
            "value": "1",
            "unit": ""
          },
          "letterSpacing": {
            "value": "",
            "unit": "px"
          },
          "wordSpacing": {
            "value": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {},
        "enabled": true
      }
    },
    "labelTypography": {
      "type": "object",
      "default": {
        "desktop": {
          "fontFamily": "",
          "fontSize": {
            "value": "12",
            "unit": "px"
          },
          "fontWeight": "400",
          "textTransform": "uppercase",
          "fontStyle": "",
          "lineHeight": {
            "value": "",
            "unit": ""
          },
          "letterSpacing": {
            "value": "1",
            "unit": "px"
          },
          "wordSpacing": {
            "value": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {},
        "enabled": true
      }
    },
    "digitColor": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "labelColor": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "separatorColor": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "itemBackground": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "itemPadding": {
      "type": "object",
      "default": {
        "desktop": {
          "top": "",
          "right": "",
          "bottom": "",
          "left": "",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "itemBorderRadius": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "spacing": {
      "type": "object",
      "default": {
        "desktop": {
          "padding": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          },
          "margin": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "advancedLayout": {
      "type": "object",
      "default": {
        "desktop": {},
        "tablet": {},
        "mobile": {}
      }
    },
    "background": {
      "type": "object",
      "default": {
        "type": "none",
        "color": {
          "light": "",
          "dark": ""
        },
        "gradient": {
          "light": "",
          "dark": ""
        },
        "image": {
          "url": "",
          "id": null,
          "position": "center center",
          "repeat": "no-repeat",
          "size": "cover",
          "attachment": "scroll"
        },
        "overlay": {
          "enabled": false,
          "color": {
            "light": "",
            "dark": ""
          },
          "opacity": 0.5
        }
      }
    },
    "border": {
      "type": "object",
      "default": {
        "desktop": {
          "style": "",
          "width": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          },
          "color": {
            "light": "",
            "dark": ""
          },
          "radius": {
            "topLeft": "",
            "topRight": "",
            "bottomRight": "",
            "bottomLeft": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "borderHover": {
      "type": "object",
      "default": {
        "desktop": {},
        "tablet": {},
        "mobile": {}
      }
    },
    "boxShadow": {
      "type": "object",
      "default": {
        "horizontal": "0",
        "vertical": "4",
        "blur": "6",
        "spread": "0",
        "color": {
          "light": "rgba(0, 0, 0, 0.1)",
          "dark": ""
        },
        "inset": false,
        "enabled": false
      }
    },
    "boxShadowHover": {
      "type": "object",
      "default": {
        "horizontal": "0",
        "vertical": "4",
        "blur": "6",
        "spread": "0",
        "color": {
          "light": "rgba(0, 0, 0, 0.1)",
          "dark": ""
        },
        "inset": false,
        "enabled": false
      }
    },
    "animation": {
      "type": "object",
      "default": {
        "type": "",
        "duration": 400,
        "delay": 0,
        "easing": "ease",
        "once": true
      }
    },
    "responsiveVisibility": {
      "type": "object",
      "default": {
        "hideOnDesktop": false,
        "hideOnTablet": false,
        "hideOnMobile": false
      }
    },
    "htmlTag": {
      "type": "string",
      "default": "div"
    },
    "htmlAttributes": {
      "type": "object",
      "default": {
        "customAttributes": []
      }
    }
  },
  "supports": {
    "anchor": true,
    "className": true,
    "html": false
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}
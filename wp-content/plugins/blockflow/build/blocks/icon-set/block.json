{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockflow/icon-set",
  "version": "1.0.0",
  "title": "Icon Set",
  "category": "blockflow",
  "description": "Display a collection of icons inline with optional links.",
  "keywords": [
    "icon",
    "icons",
    "set",
    "collection",
    "svg",
    "graphic"
  ],
  "textdomain": "blockflow",
  "attributes": {
    "blockId": {
      "type": "string"
    },
    "linkMode": {
      "type": "string",
      "default": "all",
      "enum": [
        "all",
        "individual"
      ]
    },
    "items": {
      "type": "array",
      "default": [
        {
          "icon": {
            "source": "library",
            "name": "star-bold",
            "customSvg": {
              "id": null,
              "url": ""
            }
          },
          "link": {
            "url": "",
            "target": "",
            "rel": ""
          }
        },
        {
          "icon": {
            "source": "library",
            "name": "star-bold",
            "customSvg": {
              "id": null,
              "url": ""
            }
          },
          "link": {
            "url": "",
            "target": "",
            "rel": ""
          }
        },
        {
          "icon": {
            "source": "library",
            "name": "star-bold",
            "customSvg": {
              "id": null,
              "url": ""
            }
          },
          "link": {
            "url": "",
            "target": "",
            "rel": ""
          }
        },
        {
          "icon": {
            "source": "library",
            "name": "star-bold",
            "customSvg": {
              "id": null,
              "url": ""
            }
          },
          "link": {
            "url": "",
            "target": "",
            "rel": ""
          }
        },
        {
          "icon": {
            "source": "library",
            "name": "star-half",
            "customSvg": {
              "id": null,
              "url": ""
            }
          },
          "link": {
            "url": "",
            "target": "",
            "rel": ""
          }
        }
      ]
    },
    "link": {
      "type": "object",
      "default": {
        "url": "",
        "target": "",
        "rel": ""
      }
    },
    "view": {
      "type": "string",
      "default": "custom",
      "enum": [
        "default",
        "stacked",
        "framed",
        "custom"
      ]
    },
    "shape": {
      "type": "string",
      "default": "square",
      "enum": [
        "square",
        "rounded",
        "circle",
        "custom"
      ]
    },
    "size": {
      "type": "object",
      "default": {
        "desktop": {
          "width": "24",
          "height": "24",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "gap": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "4",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "alignment": {
      "type": "object",
      "default": {
        "desktop": "left",
        "tablet": "",
        "mobile": ""
      }
    },
    "iconPadding": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "iconBorderRadius": {
      "type": "object",
      "default": {
        "desktop": {
          "topLeft": "",
          "topRight": "",
          "bottomRight": "",
          "bottomLeft": "",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "iconColor": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "iconColorHover": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "iconBgColor": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "iconBgColorHover": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "iconBorderColor": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "iconBorderColorHover": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "iconBorderWidth": {
      "type": "object",
      "default": {
        "desktop": {
          "top": "",
          "right": "",
          "bottom": "",
          "left": "",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "hoverAnimation": {
      "type": "string",
      "default": ""
    },
    "spacing": {
      "type": "object",
      "default": {
        "desktop": {
          "padding": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          },
          "margin": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "advancedLayout": {
      "type": "object",
      "default": {
        "desktop": {},
        "tablet": {},
        "mobile": {}
      }
    },
    "background": {
      "type": "object",
      "default": {
        "type": "none",
        "color": {
          "light": "",
          "dark": ""
        },
        "gradient": {
          "light": "",
          "dark": ""
        },
        "image": {
          "url": "",
          "id": null,
          "position": "center center",
          "repeat": "no-repeat",
          "size": "cover",
          "attachment": "scroll"
        },
        "overlay": {
          "enabled": false,
          "color": {
            "light": "",
            "dark": ""
          },
          "opacity": 0.5
        }
      }
    },
    "border": {
      "type": "object",
      "default": {
        "desktop": {
          "style": "",
          "width": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          },
          "color": {
            "light": "",
            "dark": ""
          },
          "radius": {
            "topLeft": "",
            "topRight": "",
            "bottomRight": "",
            "bottomLeft": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "borderHover": {
      "type": "object",
      "default": {
        "desktop": {},
        "tablet": {},
        "mobile": {}
      }
    },
    "boxShadow": {
      "type": "object",
      "default": {
        "horizontal": "0",
        "vertical": "4",
        "blur": "6",
        "spread": "0",
        "color": {
          "light": "rgba(0, 0, 0, 0.1)",
          "dark": ""
        },
        "inset": false,
        "enabled": false
      }
    },
    "boxShadowHover": {
      "type": "object",
      "default": {
        "horizontal": "0",
        "vertical": "4",
        "blur": "6",
        "spread": "0",
        "color": {
          "light": "rgba(0, 0, 0, 0.1)",
          "dark": ""
        },
        "inset": false,
        "enabled": false
      }
    },
    "animation": {
      "type": "object",
      "default": {
        "type": "",
        "duration": 400,
        "delay": 0,
        "easing": "ease",
        "once": true
      }
    },
    "itemAnimation": {
      "type": "object",
      "default": {
        "type": "",
        "duration": 600,
        "stagger": 100
      }
    },
    "responsiveVisibility": {
      "type": "object",
      "default": {
        "hideOnDesktop": false,
        "hideOnTablet": false,
        "hideOnMobile": false
      }
    },
    "htmlTag": {
      "type": "string",
      "default": "div"
    },
    "htmlAttributes": {
      "type": "object",
      "default": {
        "customAttributes": []
      }
    }
  },
  "supports": {
    "anchor": true,
    "className": true,
    "html": false
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
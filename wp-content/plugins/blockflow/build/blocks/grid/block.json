{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockflow/grid",
  "version": "1.0.0",
  "title": "Grid",
  "category": "blockflow",
  "description": "CSS Grid container with responsive column layouts.",
  "keywords": [
    "grid",
    "columns",
    "layout",
    "responsive",
    "css grid"
  ],
  "textdomain": "blockflow",
  "attributes": {
    "blockId": {
      "type": "string"
    },
    "variationSelected": {
      "type": "boolean",
      "default": false
    },
    "htmlTag": {
      "type": "string",
      "default": "div"
    },
    "containerType": {
      "type": "string",
      "default": "boxed",
      "enum": [
        "boxed",
        "full-width"
      ]
    },
    "contentTarget": {
      "type": "string",
      "default": "outer",
      "enum": [
        "outer",
        "inner"
      ]
    },
    "layout": {
      "type": "object",
      "default": {
        "desktop": {
          "columns": {
            "value": "2",
            "unit": "fr"
          },
          "rows": {
            "value": "",
            "unit": "fr"
          },
          "gaps": {
            "column": "20",
            "row": "20",
            "unit": "px"
          },
          "autoFlow": "row",
          "justifyItems": "stretch",
          "alignItems": "stretch",
          "justifyContent": "",
          "alignContent": ""
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "spacing": {
      "type": "object",
      "default": {
        "desktop": {
          "padding": {
            "top": "10",
            "right": "10",
            "bottom": "10",
            "left": "10",
            "unit": "px"
          },
          "margin": {
            "top": "",
            "right": "auto",
            "bottom": "",
            "left": "auto",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "widthFullWidth": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "100",
          "unit": "%"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "widthBoxed": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "1200",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "size": {
      "type": "object",
      "default": {
        "desktop": {
          "minHeight": {
            "value": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "background": {
      "type": "object",
      "default": {
        "type": "none",
        "color": {
          "light": "",
          "dark": ""
        },
        "gradient": {
          "light": "",
          "dark": ""
        },
        "image": {
          "url": "",
          "id": null,
          "position": "center center",
          "repeat": "no-repeat",
          "size": "cover",
          "attachment": "scroll"
        },
        "overlay": {
          "enabled": false,
          "color": {
            "light": "",
            "dark": ""
          },
          "opacity": 0.5
        }
      }
    },
    "border": {
      "type": "object",
      "default": {
        "desktop": {
          "width": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          },
          "style": "",
          "color": {
            "light": "",
            "dark": ""
          },
          "radius": {
            "topLeft": "",
            "topRight": "",
            "bottomRight": "",
            "bottomLeft": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "borderHover": {
      "type": "object",
      "default": {
        "desktop": {
          "width": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          },
          "style": "",
          "color": {
            "light": "",
            "dark": ""
          },
          "radius": {
            "topLeft": "",
            "topRight": "",
            "bottomRight": "",
            "bottomLeft": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "boxShadow": {
      "type": "object",
      "default": {
        "horizontal": "0",
        "vertical": "4",
        "blur": "6",
        "spread": "0",
        "color": {
          "light": "rgba(0, 0, 0, 0.1)",
          "dark": ""
        },
        "inset": false,
        "enabled": false
      }
    },
    "boxShadowHover": {
      "type": "object",
      "default": {
        "horizontal": "",
        "vertical": "",
        "blur": "",
        "spread": "",
        "color": {
          "light": "",
          "dark": ""
        },
        "inset": false,
        "enabled": false
      }
    },
    "zIndex": {
      "type": "string",
      "default": ""
    },
    "advancedLayout": {
      "type": "object",
      "default": {
        "desktop": {
          "alignSelf": "",
          "order": "",
          "position": "",
          "zIndex": "",
          "overflow": ""
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "responsiveVisibility": {
      "type": "object",
      "default": {
        "hideOnDesktop": false,
        "hideOnTablet": false,
        "hideOnMobile": false
      }
    },
    "htmlAttributes": {
      "type": "object",
      "default": {
        "customAttributes": []
      }
    },
    "animation": {
      "type": "object",
      "default": {
        "type": "",
        "duration": 400,
        "delay": 0,
        "easing": "ease",
        "once": true
      }
    },
    "sticky": {
      "type": "object",
      "default": {
        "enabled": false,
        "stickAt": "top",
        "offset": 0
      }
    }
  },
  "supports": {
    "anchor": true,
    "className": true,
    "html": false,
    "align": false
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
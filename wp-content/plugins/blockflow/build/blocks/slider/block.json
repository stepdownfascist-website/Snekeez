{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockflow/slider",
  "version": "1.0.0",
  "title": "Slider",
  "category": "blockflow",
  "description": "Create beautiful slideshows with customizable navigation and effects.",
  "keywords": [
    "slider",
    "carousel",
    "slideshow",
    "gallery"
  ],
  "textdomain": "blockflow",
  "supports": {
    "anchor": true,
    "className": true,
    "html": false
  },
  "attributes": {
    "blockId": {
      "type": "string"
    },
    "autoplay": {
      "type": "boolean",
      "default": false
    },
    "autoplayDelay": {
      "type": "number",
      "default": 3000
    },
    "pauseOnHover": {
      "type": "boolean",
      "default": true
    },
    "pauseOnInteraction": {
      "type": "boolean",
      "default": true
    },
    "loop": {
      "type": "boolean",
      "default": true
    },
    "speed": {
      "type": "number",
      "default": 400
    },
    "effect": {
      "type": "string",
      "default": "slide",
      "enum": [
        "slide",
        "fade",
        "cube",
        "flip",
        "coverflow",
        "creative",
        "vertical"
      ]
    },
    "minHeight": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "showArrows": {
      "type": "boolean",
      "default": true
    },
    "arrowIconPrev": {
      "type": "object",
      "default": {
        "name": "arrow-left"
      }
    },
    "arrowIconNext": {
      "type": "object",
      "default": {
        "name": "arrow-right"
      }
    },
    "showPagination": {
      "type": "boolean",
      "default": true
    },
    "paginationType": {
      "type": "string",
      "default": "bullets",
      "enum": [
        "bullets",
        "fraction",
        "progressbar"
      ]
    },
    "paginationPosition": {
      "type": "string",
      "default": "below",
      "enum": [
        "below",
        "overlay"
      ]
    },
    "arrowSize": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "20",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "arrowColor": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "arrowColorHover": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "arrowBackground": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "arrowBackgroundHover": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "arrowPadding": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "12",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "arrowBorderRadius": {
      "type": "object",
      "default": {
        "desktop": {
          "topLeft": "50",
          "topRight": "50",
          "bottomRight": "50",
          "bottomLeft": "50",
          "unit": "%"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "arrowOffset": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "20",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "bulletSize": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "8",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "bulletColor": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "bulletColorActive": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "bulletGap": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "8",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "paginationOffset": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "20",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "slidesBorderRadius": {
      "type": "object",
      "default": {
        "desktop": {
          "topLeft": "",
          "topRight": "",
          "bottomRight": "",
          "bottomLeft": "",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "spacing": {
      "type": "object",
      "default": {
        "desktop": {
          "padding": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          },
          "margin": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "advancedLayout": {
      "type": "object",
      "default": {
        "desktop": {},
        "tablet": {},
        "mobile": {}
      }
    },
    "background": {
      "type": "object",
      "default": {
        "type": "none",
        "color": {
          "light": "",
          "dark": ""
        },
        "gradient": {
          "light": "",
          "dark": ""
        },
        "image": {
          "url": "",
          "id": null,
          "position": "center center",
          "repeat": "no-repeat",
          "size": "cover",
          "attachment": "scroll"
        },
        "overlay": {
          "enabled": false,
          "color": {
            "light": "",
            "dark": ""
          },
          "opacity": 0.5
        }
      }
    },
    "border": {
      "type": "object",
      "default": {
        "desktop": {
          "style": "",
          "width": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          },
          "color": {
            "light": "",
            "dark": ""
          },
          "radius": {
            "topLeft": "",
            "topRight": "",
            "bottomRight": "",
            "bottomLeft": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "borderHover": {
      "type": "object",
      "default": {
        "desktop": {},
        "tablet": {},
        "mobile": {}
      }
    },
    "boxShadow": {
      "type": "object",
      "default": {
        "horizontal": "",
        "vertical": "",
        "blur": "",
        "spread": "",
        "color": {
          "light": "",
          "dark": ""
        },
        "inset": false,
        "enabled": false
      }
    },
    "boxShadowHover": {
      "type": "object",
      "default": {
        "horizontal": "",
        "vertical": "",
        "blur": "",
        "spread": "",
        "color": {
          "light": "",
          "dark": ""
        },
        "inset": false,
        "enabled": false
      }
    },
    "animation": {
      "type": "object",
      "default": {
        "type": "",
        "duration": 400,
        "delay": 0,
        "easing": "ease",
        "once": true
      }
    },
    "responsiveVisibility": {
      "type": "object",
      "default": {
        "hideOnDesktop": false,
        "hideOnTablet": false,
        "hideOnMobile": false
      }
    },
    "htmlTag": {
      "type": "string",
      "default": "div"
    },
    "htmlAttributes": {
      "type": "object",
      "default": {
        "customAttributes": []
      }
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js",
  "viewStyle": "file:./view.css"
}
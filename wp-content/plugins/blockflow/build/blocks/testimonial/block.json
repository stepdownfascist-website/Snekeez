{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockflow/testimonial",
  "version": "1.0.0",
  "title": "Testimonial",
  "category": "blockflow",
  "description": "Display customer testimonials with rating, quote, and author information.",
  "keywords": [
    "testimonial",
    "review",
    "quote",
    "rating",
    "feedback"
  ],
  "textdomain": "blockflow",
  "attributes": {
    "blockId": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 5
    },
    "showRating": {
      "type": "boolean",
      "default": true
    },
    "showAvatar": {
      "type": "boolean",
      "default": true
    },
    "title": {
      "type": "string",
      "default": "Amazing Experience"
    },
    "quote": {
      "type": "string",
      "default": "This product exceeded all my expectations. The quality is outstanding and the customer service team was incredibly helpful throughout the entire process."
    },
    "authorImage": {
      "type": "object",
      "default": {
        "id": 0,
        "url": "",
        "alt": ""
      }
    },
    "authorName": {
      "type": "string",
      "default": "John Smith"
    },
    "authorJob": {
      "type": "string",
      "default": "CEO, Company Inc."
    },
    "alignment": {
      "type": "string",
      "default": "left"
    },
    "ratingColor": {
      "type": "object",
      "default": {
        "light": "#000000",
        "dark": ""
      }
    },
    "ratingSize": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "20",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "ratingSpacing": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "16",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "titleTypography": {
      "type": "object",
      "default": {
        "desktop": {
          "fontFamily": "",
          "fontSize": {
            "value": "18",
            "unit": "px"
          },
          "fontWeight": "700",
          "fontStyle": "",
          "textTransform": "",
          "textDecoration": "",
          "lineHeight": {
            "value": "",
            "unit": "em"
          },
          "letterSpacing": {
            "value": "",
            "unit": "px"
          },
          "wordSpacing": {
            "value": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "titleColor": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "titleSpacing": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "16",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "quoteTypography": {
      "type": "object",
      "default": {
        "desktop": {
          "fontFamily": "",
          "fontSize": {
            "value": "15",
            "unit": "px"
          },
          "fontWeight": "",
          "fontStyle": "",
          "textTransform": "",
          "textDecoration": "",
          "lineHeight": {
            "value": "",
            "unit": "em"
          },
          "letterSpacing": {
            "value": "",
            "unit": "px"
          },
          "wordSpacing": {
            "value": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "quoteColor": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "quoteSpacing": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "16",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "authorImageSize": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "40",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "nameTypography": {
      "type": "object",
      "default": {
        "desktop": {
          "fontFamily": "",
          "fontSize": {
            "value": "15",
            "unit": "px"
          },
          "fontWeight": "600",
          "fontStyle": "",
          "textTransform": "",
          "textDecoration": "",
          "lineHeight": {
            "value": "",
            "unit": "em"
          },
          "letterSpacing": {
            "value": "",
            "unit": "px"
          },
          "wordSpacing": {
            "value": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "nameColor": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "jobTypography": {

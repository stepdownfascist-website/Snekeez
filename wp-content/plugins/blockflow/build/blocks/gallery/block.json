{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockflow/gallery",
  "version": "1.0.0",
  "title": "Gallery",
  "category": "blockflow",
  "description": "Display images in beautiful grid, masonry, or tiled layouts with lightbox support.",
  "keywords": [
    "gallery",
    "images",
    "masonry",
    "grid",
    "lightbox",
    "photos"
  ],
  "textdomain": "blockflow",
  "attributes": {
    "blockId": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object"
      }
    },
    "displayType": {
      "type": "string",
      "default": "tiled",
      "enum": [
        "tiled",
        "grid",
        "masonry"
      ]
    },
    "columns": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "3"
        },
        "tablet": {
          "value": "2"
        },
        "mobile": {
          "value": "1"
        }
      }
    },
    "gap": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "12",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "imageSize": {
      "type": "string",
      "default": "full"
    },
    "aspectRatio": {
      "type": "object",
      "default": {
        "enabled": false,
        "desktop": {
          "value": 75
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "clickAction": {
      "type": "string",
      "default": "lightbox",
      "enum": [
        "none",
        "lightbox",
        "media",
        "link"
      ]
    },
    "caption": {
      "type": "object",
      "default": {
        "display": "overlay",
        "position": "bottom-center",
        "visibility": "always",
        "alignment": "center"
      }
    },
    "hoverEffect": {
      "type": "string",
      "default": "zoom-in",
      "enum": [
        "none",
        "zoom-in",
        "zoom-out",
        "slide",
        "rotate",
        "grayscale",
        "blur",
        "shine"
      ]
    },
    "lazyLoad": {
      "type": "boolean",
      "default": true
    },
    "overlayColor": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "overlayOpacity": {
      "type": "number",
      "default": 0.3
    },
    "overlayHoverOpacity": {
      "type": "number",
      "default": 0.5
    },
    "imageBorder": {
      "type": "object",
      "default": {
        "desktop": {
          "style": "",
          "width": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          },
          "color": {
            "light": "",
            "dark": ""
          },
          "radius": {
            "topLeft": "8",
            "topRight": "8",
            "bottomRight": "8",
            "bottomLeft": "8",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "imageBorderHover": {
      "type": "object",
      "default": {
        "desktop": {},
        "tablet": {},
        "mobile": {}
      }
    },
    "imageBoxShadow": {
      "type": "object",
      "default": {
        "horizontal": "0",
        "vertical": "4",
        "blur": "6",
        "spread": "0",
        "color": {
          "light": "rgba(0, 0, 0, 0.1)",
          "dark": ""
        },
        "inset": false,
        "enabled": false
      }
    },
    "imageBoxShadowHover": {
      "type": "object",
      "default": {
        "horizontal": "0",
        "vertical": "4",
        "blur": "6",
        "spread": "0",
        "color": {
          "light": "rgba(0, 0, 0, 0.1)",
          "dark": ""
        },
        "inset": false,
        "enabled": false
      }
    },
    "captionTypography": {
      "type": "object",
      "default": {
        "desktop": {
          "fontFamily": "",
          "fontSize": {
            "value": "12",
            "unit": "px"
          },
          "fontWeight": "",
          "textTransform": "",
          "fontStyle": "",
          "textDecoration": "",
          "lineHeight": {
            "value": "",
            "unit": "em"
          },
          "letterSpacing": {
            "value": "",
            "unit": "px"
          },
          "wordSpacing": {
            "value": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "captionColor": {
      "type": "object",
      "default": {
        "light": "#ffffff",
        "dark": ""
      }
    },
    "captionBackground": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "captionPadding": {
      "type": "object",
      "default": {
        "desktop": {
          "top": "8",
          "right": "12",
          "bottom": "8",
          "left": "12",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "captionBorderRadius": {
      "type": "object",
      "default": {
        "desktop": {
          "topLeft": "",
          "topRight": "",
          "bottomRight": "",
          "bottomLeft": "",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "lightbox": {
      "type": "object",
      "default": {
        "backgroundColor": {
          "light": "",
          "dark": ""
        },
        "iconColor": {
          "light": "",
          "dark": ""
        },
        "iconSize": {
          "desktop": {
            "value": "24",
            "unit": "px"
          },
          "tablet": {},
          "mobile": {}
        },
        "iconBorderRadius": {
          "desktop": {
            "topLeft": "",
            "topRight": "",
            "bottomRight": "",
            "bottomLeft": "",
            "unit": "px"
          },
          "tablet": {},
          "mobile": {}
        },
        "arrowIconPrev": {
          "name": "alt-arrow-left"
        },
        "arrowIconNext": {
          "name": "alt-arrow-right"
        },
        "showCaption": true
      }
    },
    "spacing": {
      "type": "object",
      "default": {
        "desktop": {
          "padding": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          },
          "margin": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "advancedLayout": {
      "type": "object",
      "default": {
        "desktop": {},
        "tablet": {},
        "mobile": {}
      }
    },
    "background": {
      "type": "object",
      "default": {
        "type": "none",
        "color": {
          "light": "",
          "dark": ""
        },
        "gradient": {
          "light": "",
          "dark": ""
        },
        "image": {
          "url": "",
          "id": null,
          "position": "center center",
          "repeat": "no-repeat",
          "size": "cover",
          "attachment": "scroll"
        },
        "overlay": {
          "enabled": false,
          "color": {
            "light": "",
            "dark": ""
          },
          "opacity": 0.5
        }
      }
    },
    "border": {
      "type": "object",
      "default": {
        "desktop": {
          "style": "",
          "width": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          },
          "color": {
            "light": "",
            "dark": ""
          },
          "radius": {
            "topLeft": "",
            "topRight": "",
            "bottomRight": "",
            "bottomLeft": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "borderHover": {
      "type": "object",
      "default": {
        "desktop": {},
        "tablet": {},
        "mobile": {}
      }
    },
    "boxShadow": {
      "type": "object",
      "default": {
        "horizontal": "0",
        "vertical": "4",
        "blur": "6",
        "spread": "0",
        "color": {
          "light": "rgba(0, 0, 0, 0.1)",
          "dark": ""
        },
        "inset": false,
        "enabled": false
      }
    },
    "boxShadowHover": {
      "type": "object",
      "default": {
        "horizontal": "0",
        "vertical": "4",
        "blur": "6",
        "spread": "0",
        "color": {
          "light": "rgba(0, 0, 0, 0.1)",
          "dark": ""
        },
        "inset": false,
        "enabled": false
      }
    },
    "animation": {
      "type": "object",
      "default": {
        "type": "",
        "duration": 400,
        "delay": 0,
        "easing": "ease",
        "once": true
      }
    },
    "itemAnimation": {
      "type": "object",
      "default": {
        "type": "",
        "duration": 600,
        "stagger": 100
      }
    },
    "responsiveVisibility": {
      "type": "object",
      "default": {
        "hideOnDesktop": false,
        "hideOnTablet": false,
        "hideOnMobile": false
      }
    },
    "htmlTag": {
      "type": "string",
      "default": "div"
    },
    "htmlAttributes": {
      "type": "object",
      "default": {
        "customAttributes": []
      }
    }
  },
  "supports": {
    "anchor": true,
    "className": true,
    "html": false
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}
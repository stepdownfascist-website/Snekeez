        {
          "id": "item-1",
          "number": {
            "value": "60",
            "prefix": "",
            "suffix": "K+"
          },
          "label": "Happy Users",
          "icon": {
            "source": "library",
            "name": "hearts",
            "customSvg": {
              "id": null,
              "url": ""
            }
          }
        },
        {
          "id": "item-2",
          "number": {
            "value": "56",
            "prefix": "",
            "suffix": "+"
          },
          "label": "Websites",
          "icon": {
            "source": "library",
            "name": "laptop-2",
            "customSvg": {
              "id": null,
              "url": ""
            }
          }
        },
        {
          "id": "item-3",
          "number": {
            "value": "300",
            "prefix": "",
            "suffix": "+"

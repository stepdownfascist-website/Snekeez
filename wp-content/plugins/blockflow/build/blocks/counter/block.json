{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockflow/counter",
  "version": "1.0.0",
  "title": "Counter",
  "category": "blockflow",
  "description": "Display animated counter statistics with icons and labels.",
  "keywords": [
    "counter",
    "stats",
    "statistics",
    "number",
    "count"

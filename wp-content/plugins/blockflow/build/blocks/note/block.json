{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockflow/note",
  "version": "1.0.0",
  "title": "Note",
  "category": "blockflow",
  "description": "Callout note with customizable type, icon, and styling.",
  "keywords": [
    "note",
    "callout",
    "alert",
    "info",
    "warning",
    "notice"
  ],
  "textdomain": "blockflow",
  "supports": {
    "anchor": true,
    "className": true,
    "html": false
  },
  "attributes": {
    "blockId": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "showTitle": {
      "type": "boolean",
      "default": true
    },
    "showDivider": {
      "type": "boolean",
      "default": true
    },
    "titleTag": {
      "type": "string",
      "default": "h2",
      "enum": [
        "h1",
        "h2",
        "h3",
        "h4",
        "h5",
        "h6",
        "div",
        "span",
        "p"
      ]
    },
    "alignment": {
      "type": "object",
      "default": {
        "desktop": "",
        "tablet": "",
        "mobile": ""
      }
    },
    "dismissIcon": {
      "type": "object",
      "default": {
        "source": "library",
        "name": "close",
        "customSvg": {
          "id": null,
          "url": ""
        }
      }
    },
    "dismissDuration": {
      "type": "number",
      "default": 1
    },
    "noteType": {
      "type": "string",
      "default": "default",
      "enum": [
        "default",
        "info",
        "warning",
        "success",
        "error",
        "custom"
      ]
    },
    "noteStyle": {
      "type": "string",
      "default": "shadow",
      "enum": [
        "shadow",
        "bordered",
        "filled",
        "outline",
        "custom"
      ]
    },
    "noteIcon": {
      "type": "object",
      "default": {
        "source": "library",
        "name": "lightbulb",
        "customSvg": {
          "id": null,
          "url": ""
        }
      }
    },
    "collapsible": {
      "type": "boolean",
      "default": true
    },
    "toggleIcon": {
      "type": "object",
      "default": {
        "source": "library",
        "name": "alt-arrow-down",
        "customSvg": {
          "id": null,
          "url": ""
        }
      }
    },
    "dismissible": {
      "type": "boolean",
      "default": true
    },
    "controlIconSize": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "20",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "headerColor": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "iconColor": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "headerBackground": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "headerColorHover": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "headerBackgroundHover": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "contentBackground": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "headerPadding": {
      "type": "object",
      "default": {
        "desktop": {
          "top": "0",
          "right": "0",
          "bottom": "12",
          "left": "0",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "contentPadding": {
      "type": "object",
      "default": {
        "desktop": {
          "top": "12",
          "right": "0",
          "bottom": "0",
          "left": "0",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "contentGap": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "20",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "titleTypography": {
      "type": "object",
      "default": {
        "desktop": {
          "fontFamily": "",
          "fontSize": {
            "value": "18",
            "unit": "px"
          },
          "fontWeight": "",
          "textTransform": "",
          "fontStyle": "",
          "textDecoration": "",
          "lineHeight": {
            "value": "",
            "unit": "em"
          },
          "letterSpacing": {
            "value": "",
            "unit": "px"
          },
          "wordSpacing": {
            "value": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {},
        "enabled": true
      }
    },
    "spacing": {
      "type": "object",
      "default": {
        "desktop": {
          "padding": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          },
          "margin": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "advancedLayout": {
      "type": "object",
      "default": {
        "desktop": {
          "overflow": "clip"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "background": {
      "type": "object",
      "default": {
        "type": "none",
        "color": {
          "light": "",
          "dark": ""
        },
        "gradient": {
          "light": "",
          "dark": ""
        },
        "image": {
          "url": "",
          "id": null,
          "position": "center center",
          "repeat": "no-repeat",
          "size": "cover",
          "attachment": "scroll"
        },
        "overlay": {
          "enabled": false,
          "color": {
            "light": "",
            "dark": ""
          },
          "opacity": 0.5
        }
      }
    },
    "border": {
      "type": "object",
      "default": {
        "desktop": {
          "style": "",
          "width": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          },
          "color": {
            "light": "",
            "dark": ""
          },
          "radius": {
            "topLeft": "",
            "topRight": "",
            "bottomRight": "",
            "bottomLeft": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "borderHover": {
      "type": "object",
      "default": {
        "desktop": {},
        "tablet": {},
        "mobile": {}
      }
    },
    "boxShadow": {
      "type": "object",
      "default": {
        "horizontal": "0",
        "vertical": "4",
        "blur": "6",
        "spread": "0",
        "color": {
          "light": "rgba(0, 0, 0, 0.1)",
          "dark": ""
        },
        "inset": false,
        "enabled": false
      }
    },
    "boxShadowHover": {
      "type": "object",
      "default": {
        "horizontal": "0",
        "vertical": "4",
        "blur": "6",
        "spread": "0",
        "color": {
          "light": "rgba(0, 0, 0, 0.1)",
          "dark": ""
        },
        "inset": false,
        "enabled": false
      }
    },
    "animation": {
      "type": "object",
      "default": {
        "type": "",
        "duration": 400,
        "delay": 0,
        "easing": "ease",
        "once": true
      }
    },
    "responsiveVisibility": {
      "type": "object",
      "default": {
        "hideOnDesktop": false,
        "hideOnTablet": false,
        "hideOnMobile": false
      }
    },
    "htmlTag": {
      "type": "string",
      "default": "div"
    },
    "htmlAttributes": {
      "type": "object",
      "default": {
        "customAttributes": []
      }
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}
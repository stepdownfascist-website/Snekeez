{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockflow/text",
  "version": "1.0.0",
  "title": "Text",
  "category": "blockflow",
  "description": "Advanced text block with typography, columns, and effects.",
  "keywords": [
    "text",
    "paragraph",
    "content",
    "p",
    "columns"
  ],
  "textdomain": "blockflow",
  "attributes": {
    "blockId": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut elit tellus, luctus nec ullamcorper mattis, pulvinar dapibus leo."
    },
    "htmlTag": {
      "type": "string",
      "default": "p",
      "enum": [
        "p",
        "div",
        "span",
        "h1",
        "h2",
        "h3",
        "h4",
        "h5",
        "h6"
      ]
    },
    "columns": {
      "type": "object",
      "default": {
        "desktop": "1",
        "tablet": "",
        "mobile": ""
      }
    },
    "columnsGap": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "alignment": {
      "type": "object",
      "default": {
        "desktop": "",
        "tablet": "",
        "mobile": ""
      }
    },
    "typography": {
      "type": "object",
      "default": {
        "desktop": {
          "fontFamily": "",
          "fontSize": {
            "value": "17",
            "unit": "px"
          },
          "fontWeight": "",
          "textTransform": "",
          "fontStyle": "",
          "textDecoration": "",
          "lineHeight": {
            "value": "1.6",
            "unit": "em"
          },
          "letterSpacing": {
            "value": "",
            "unit": "px"
          },
          "wordSpacing": {
            "value": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {},
        "enabled": true
      }
    },
    "textColor": {
      "type": "object",
      "default": {
        "light": "#686868",
        "dark": ""
      }
    },
    "textColorHover": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "textStroke": {
      "type": "object",
      "default": {
        "width": {
          "desktop": {
            "value": "",
            "unit": "px"
          },
          "tablet": {},
          "mobile": {}
        },
        "color": {
          "light": "",
          "dark": ""
        },
        "enabled": false
      }
    },
    "textShadow": {
      "type": "object",
      "default": {
        "horizontal": "0",
        "vertical": "2",
        "blur": "4",
        "color": {
          "light": "",
          "dark": ""
        },
        "enabled": false
      }
    },
    "blendMode": {
      "type": "string",
      "default": ""
    },
    "spacing": {
      "type": "object",
      "default": {
        "desktop": {
          "padding": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          },
          "margin": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "advancedLayout": {
      "type": "object",
      "default": {
        "desktop": {},
        "tablet": {},
        "mobile": {}
      }
    },
    "background": {
      "type": "object",
      "default": {
        "type": "none",
        "color": {
          "light": "",
          "dark": ""
        },
        "gradient": {
          "light": "",
          "dark": ""
        },
        "image": {
          "url": "",
          "id": null,
          "position": "center center",
          "repeat": "no-repeat",
          "size": "cover",
          "attachment": "scroll"
        },
        "overlay": {
          "enabled": false,
          "color": {
            "light": "",
            "dark": ""
          },
          "opacity": 0.5
        }
      }
    },
    "border": {
      "type": "object",
      "default": {
        "desktop": {
          "style": "",
          "width": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          },
          "color": {
            "light": "",
            "dark": ""
          },
          "radius": {
            "topLeft": "",
            "topRight": "",
            "bottomRight": "",
            "bottomLeft": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "borderHover": {
      "type": "object",
      "default": {
        "desktop": {},
        "tablet": {},
        "mobile": {}
      }
    },
    "boxShadow": {
      "type": "object",
      "default": {
        "horizontal": "0",
        "vertical": "4",
        "blur": "6",
        "spread": "0",
        "color": {
          "light": "rgba(0, 0, 0, 0.1)",
          "dark": ""
        },
        "inset": false,
        "enabled": false
      }
    },
    "boxShadowHover": {
      "type": "object",
      "default": {
        "horizontal": "0",
        "vertical": "4",
        "blur": "6",
        "spread": "0",
        "color": {
          "light": "rgba(0, 0, 0, 0.1)",
          "dark": ""
        },
        "inset": false,
        "enabled": false
      }
    },
    "animation": {
      "type": "object",
      "default": {
        "type": "",
        "duration": 400,
        "delay": 0,
        "easing": "ease",
        "once": true
      }
    },
    "responsiveVisibility": {
      "type": "object",
      "default": {
        "hideOnDesktop": false,
        "hideOnTablet": false,
        "hideOnMobile": false
      }
    },
    "htmlAttributes": {
      "type": "object",
      "default": {
        "customAttributes": []
      }
    }
  },
  "supports": {
    "anchor": true,
    "className": true,
    "html": false
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
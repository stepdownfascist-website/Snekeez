        "tablet": {},
        "mobile": {}
      }
    },
    "imageWidth": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "100",
          "unit": "%"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "iconColor": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }

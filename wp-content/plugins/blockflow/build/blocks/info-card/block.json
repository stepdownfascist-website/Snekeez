{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockflow/info-card",
  "version": "1.0.0",
  "title": "Info Card",
  "category": "blockflow",
  "description": "Single info card with media, title, description and optional link.",
  "keywords": [
    "info",
    "card",
    "icon",
    "feature"
  ],
  "textdomain": "blockflow",
  "attributes": {
    "blockId": {
      "type": "string"
    },
    "stylePreset": {
      "type": "string",
      "default": "icon-top"
    },
    "boxStyle": {
      "type": "string",
      "default": "custom"
    },
    "icon": {
      "type": "object",
      "default": {
        "source": "library",
        "name": "star",
        "customSvg": {
          "id": null,
          "url": ""
        }
      }
    },
    "mediaImage": {
      "type": "object",
      "default": {
        "id": null,
        "url": "",
        "alt": ""
      }
    },
    "mediaType": {
      "type": "string",
      "default": "icon",
      "enum": [
        "icon",
        "image"
      ]
    },
    "mediaView": {
      "type": "string",
      "default": "default",
      "enum": [
        "default",
        "stacked",
        "framed",
        "custom"

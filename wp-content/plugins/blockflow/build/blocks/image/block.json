{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockflow/image",
  "version": "1.0.0",
  "title": "Image",
  "category": "blockflow",
  "description": "Display images with advanced styling options including masks, overlays, and hover effects.",
  "keywords": [
    "image",
    "photo",
    "picture",
    "media"
  ],
  "textdomain": "blockflow",
  "attributes": {
    "blockId": {
      "type": "string"
    },
    "imageWidth": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "",
          "unit": "%"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "imageAlignment": {
      "type": "object",
      "default": {
        "desktop": "",
        "tablet": "",
        "mobile": ""
      }
    },
    "image": {
      "type": "object",
      "default": {
        "id": null,
        "url": "",
        "alt": "",
        "width": null,
        "height": null,
        "sizes": {}
      }
    },
    "imageSize": {
      "type": "string",
      "default": "full"
    },
    "objectFit": {
      "type": "string",
      "default": "cover",
      "enum": [
        "cover",
        "contain",
        "fill"
      ]
    },
    "aspectRatio": {
      "type": "object",
      "default": {
        "enabled": false,
        "desktop": {
          "value": 56.25
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "lazyLoad": {
      "type": "boolean",
      "default": true
    },
    "caption": {
      "type": "object",
      "default": {
        "display": "none",
        "position": "bottom-center",
        "visibility": "always",
        "alignment": "center"
      }
    },
    "captionTypography": {
      "type": "object",
      "default": {
        "desktop": {
          "fontFamily": "",
          "fontSize": {
            "value": "14",
            "unit": "px"
          },
          "fontWeight": "",
          "textTransform": "",
          "fontStyle": "",
          "textDecoration": "",
          "lineHeight": {
            "value": "",
            "unit": "em"
          },
          "letterSpacing": {
            "value": "",
            "unit": "px"
          },
          "wordSpacing": {
            "value": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "captionColor": {
      "type": "object",
      "default": {
        "light": "#fff",
        "dark": ""
      }
    },
    "captionBackground": {
      "type": "object",
      "default": {
        "light": "#000",
        "dark": ""
      }
    },
    "captionPadding": {
      "type": "object",
      "default": {
        "desktop": {
          "top": "8",
          "right": "12",
          "bottom": "8",
          "left": "12",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "captionBorderRadius": {
      "type": "object",
      "default": {
        "desktop": {
          "topLeft": "",
          "topRight": "",
          "bottomRight": "",
          "bottomLeft": "",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "link": {
      "type": "object",
      "default": {
        "url": "",
        "target": "",
        "rel": ""
      }
    },
    "clickAction": {
      "type": "string",
      "default": "lightbox",
      "enum": [
        "none",
        "lightbox",
        "link",
        "media"
      ]
    },
    "lightbox": {
      "type": "object",
      "default": {
        "backgroundColor": {
          "light": "#111111",
          "dark": ""
        },
        "iconColor": {
          "light": "#FFFFFF",
          "dark": ""
        },
        "iconSize": {
          "desktop": {
            "value": "24",
            "unit": "px"
          },
          "tablet": {},
          "mobile": {}
        },
        "iconBorderRadius": {
          "desktop": {
            "topLeft": "8",
            "topRight": "8",
            "bottomRight": "8",
            "bottomLeft": "8",
            "unit": "px"
          },
          "tablet": {},
          "mobile": {}
        },
        "showCaption": true
      }
    },
    "imageMask": {
      "type": "object",
      "default": {
        "shape": "none",
        "customImage": {
          "id": null,
          "url": ""
        },
        "size": "contain",
        "position": "center center",
        "repeat": "no-repeat"
      }
    },
    "hoverEffect": {
      "type": "string",
      "default": "none",
      "enum": [
        "none",
        "zoom-in",
        "zoom-out",
        "slide",
        "rotate",
        "grayscale",
        "blur",
        "shine"
      ]
    },
    "imageOverlay": {
      "type": "object",
      "default": {
        "gradient": {
          "light": "",
          "dark": ""
        },
        "opacity": 0.5
      }
    },
    "borderRadius": {
      "type": "object",
      "default": {
        "desktop": {
          "topLeft": "8",
          "topRight": "8",
          "bottomRight": "8",
          "bottomLeft": "8",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "spacing": {
      "type": "object",
      "default": {
        "desktop": {
          "padding": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          },
          "margin": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "advancedLayout": {
      "type": "object",
      "default": {
        "desktop": {},
        "tablet": {},
        "mobile": {}
      }
    },
    "background": {
      "type": "object",
      "default": {
        "type": "none",
        "color": {
          "light": "",
          "dark": ""
        },
        "gradient": {
          "light": "",
          "dark": ""
        },
        "image": {
          "url": "",
          "id": null,
          "position": "center center",
          "repeat": "no-repeat",
          "size": "cover",
          "attachment": "scroll"
        },
        "overlay": {
          "enabled": false,
          "color": {
            "light": "",
            "dark": ""
          },
          "opacity": 0.5
        }
      }
    },
    "border": {
      "type": "object",
      "default": {
        "desktop": {
          "style": "",
          "width": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          },
          "color": {
            "light": "",
            "dark": ""
          },
          "radius": {
            "topLeft": "",
            "topRight": "",
            "bottomRight": "",
            "bottomLeft": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "borderHover": {
      "type": "object",
      "default": {
        "desktop": {},
        "tablet": {},
        "mobile": {}
      }
    },
    "boxShadow": {
      "type": "object",
      "default": {
        "horizontal": "0",
        "vertical": "4",
        "blur": "6",
        "spread": "0",
        "color": {
          "light": "rgba(0, 0, 0, 0.1)",
          "dark": ""
        },
        "inset": false,
        "enabled": false
      }
    },
    "boxShadowHover": {
      "type": "object",
      "default": {
        "horizontal": "0",
        "vertical": "4",
        "blur": "6",
        "spread": "0",
        "color": {
          "light": "rgba(0, 0, 0, 0.1)",
          "dark": ""
        },
        "inset": false,
        "enabled": false
      }
    },
    "animation": {
      "type": "object",
      "default": {
        "type": "",
        "duration": 400,
        "delay": 0,
        "easing": "ease",
        "once": true
      }
    },
    "responsiveVisibility": {
      "type": "object",
      "default": {
        "hideOnDesktop": false,
        "hideOnTablet": false,
        "hideOnMobile": false
      }
    },
    "htmlAttributes": {
      "type": "object",
      "default": {
        "customAttributes": []
      }
    }
  },
  "supports": {
    "anchor": true,
    "className": true,
    "html": false
  },
  "render": "file:./render.php",
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}
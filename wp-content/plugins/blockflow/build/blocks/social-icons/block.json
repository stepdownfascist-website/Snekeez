{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockflow/social-icons",
  "version": "1.0.0",
  "title": "Social Icons",
  "category": "blockflow",
  "description": "Display a collection of social media icons with links.",
  "keywords": [
    "social",
    "icons",
    "media",
    "share",
    "links",
    "facebook",
    "twitter",
    "instagram"
  ],
  "textdomain": "blockflow",
  "attributes": {
    "blockId": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "default": [
        {
          "platform": "facebook",
          "link": {
            "url": "",
            "target": "_blank",
            "rel": "noopener noreferrer"
          },
          "colorMode": "official",
          "primaryColor": {
            "light": "",
            "dark": ""
          },
          "secondaryColor": {
            "light": "",
            "dark": ""
          }
        },
        {
          "platform": "x-twitter",
          "link": {
            "url": "",
            "target": "_blank",
            "rel": "noopener noreferrer"
          },
          "colorMode": "official",
          "primaryColor": {
            "light": "",
            "dark": ""
          },
          "secondaryColor": {
            "light": "",
            "dark": ""
          }
        },
        {
          "platform": "instagram",
          "link": {
            "url": "",
            "target": "_blank",
            "rel": "noopener noreferrer"
          },
          "colorMode": "official",
          "primaryColor": {
            "light": "",
            "dark": ""
          },
          "secondaryColor": {
            "light": "",
            "dark": ""
          }
        }
      ]
    },
    "view": {
      "type": "string",
      "default": "stacked",
      "enum": [
        "default",
        "stacked",
        "framed"
      ]
    },
    "shape": {
      "type": "string",
      "default": "rounded",
      "enum": [
        "square",
        "rounded",
        "circle"
      ]
    },
    "size": {
      "type": "object",
      "default": {
        "desktop": {
          "width": "40",
          "height": "40",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "gap": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "4",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "alignment": {
      "type": "object",
      "default": {
        "desktop": "left",
        "tablet": "",
        "mobile": ""
      }
    },
    "iconPadding": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "8",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "iconBorderRadius": {
      "type": "object",
      "default": {
        "desktop": {
          "topLeft": "8",
          "topRight": "8",
          "bottomRight": "8",
          "bottomLeft": "8",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "primaryColor": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "secondaryColor": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "primaryColorHover": {
      "type": "object",
      "default": {
        "light": "#ffffff",
        "dark": ""
      }
    },
    "secondaryColorHover": {
      "type": "object",
      "default": {
        "light": "#000000",
        "dark": ""
      }
    },
    "hoverAnimation": {
      "type": "string",
      "default": "grow"
    },
    "spacing": {
      "type": "object",
      "default": {
        "desktop": {
          "padding": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          },
          "margin": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "advancedLayout": {
      "type": "object",
      "default": {
        "desktop": {},
        "tablet": {},
        "mobile": {}
      }
    },
    "background": {
      "type": "object",
      "default": {
        "type": "none",
        "color": {
          "light": "",
          "dark": ""
        },
        "gradient": {
          "light": "",
          "dark": ""
        },
        "image": {
          "url": "",
          "id": null,
          "position": "center center",
          "repeat": "no-repeat",
          "size": "cover",
          "attachment": "scroll"
        },
        "overlay": {
          "enabled": false,
          "color": {
            "light": "",
            "dark": ""
          },
          "opacity": 0.5
        }
      }
    },
    "border": {
      "type": "object",
      "default": {
        "desktop": {
          "style": "",
          "width": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          },
          "color": {
            "light": "",
            "dark": ""
          },
          "radius": {
            "topLeft": "",
            "topRight": "",
            "bottomRight": "",
            "bottomLeft": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "borderHover": {
      "type": "object",
      "default": {
        "desktop": {},
        "tablet": {},
        "mobile": {}
      }
    },
    "boxShadow": {
      "type": "object",
      "default": {
        "horizontal": "0",
        "vertical": "4",
        "blur": "6",
        "spread": "0",
        "color": {
          "light": "rgba(0, 0, 0, 0.1)",
          "dark": ""
        },
        "inset": false,
        "enabled": false
      }
    },
    "boxShadowHover": {
      "type": "object",
      "default": {
        "horizontal": "0",
        "vertical": "4",
        "blur": "6",
        "spread": "0",
        "color": {
          "light": "rgba(0, 0, 0, 0.1)",
          "dark": ""
        },
        "inset": false,
        "enabled": false
      }
    },
    "animation": {
      "type": "object",
      "default": {
        "type": "",
        "duration": 400,
        "delay": 0,
        "easing": "ease",
        "once": true
      }
    },
    "itemAnimation": {
      "type": "object",
      "default": {
        "type": "",
        "duration": 600,
        "stagger": 100
      }
    },
    "responsiveVisibility": {
      "type": "object",
      "default": {
        "hideOnDesktop": false,
        "hideOnTablet": false,
        "hideOnMobile": false
      }
    },
    "htmlTag": {
      "type": "string",
      "default": "div"
    },
    "htmlAttributes": {
      "type": "object",
      "default": {
        "customAttributes": []
      }
    }
  },
  "supports": {
    "anchor": true,
    "className": true,
    "html": false
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
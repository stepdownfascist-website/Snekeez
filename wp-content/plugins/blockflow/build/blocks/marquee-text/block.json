{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockflow/marquee-text",
  "version": "1.0.0",
  "title": "Marquee Text",
  "category": "blockflow",
  "description": "Display scrolling text with decorative dividers for announcements and highlights.",
  "keywords": [
    "marquee",
    "scroll",
    "text",
    "ticker",
    "announcement",
    "sliding"
  ],
  "textdomain": "blockflow",
  "attributes": {
    "blockId": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "default": [
        {
          "id": "item-1",
          "text": "Your Text Here"
        },
        {
          "id": "item-2",
          "text": "Another Text"
        },
        {
          "id": "item-3",
          "text": "More Text"
        },
        {
          "id": "item-4",
          "text": "Add Your Own"
        }
      ]
    },
    "divider": {
      "type": "object",
      "default": {
        "type": "icon",
        "icon": {
          "source": "library",
          "name": "bolt",
          "customSvg": null
        },
        "image": {
          "id": null,
          "url": "",
          "alt": ""
        }
      }
    },
    "scroll": {
      "type": "object",
      "default": {
        "direction": "left",
        "speed": 50,
        "pauseOnHover": true
      }
    },
    "gap": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "24",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "typography": {
      "type": "object",
      "default": {
        "desktop": {
          "fontFamily": "",
          "fontSize": {
            "value": "40",
            "unit": "px"
          },
          "fontWeight": "700",
          "fontStyle": "",
          "textTransform": "uppercase",
          "textDecoration": "",
          "lineHeight": {
            "value": "",
            "unit": "em"
          },
          "letterSpacing": {
            "value": "-1",
            "unit": "px"
          },
          "wordSpacing": {
            "value": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "textColor": {
      "type": "object",
      "default": {
        "light": "#000000",
        "dark": ""
      }
    },
    "textColorHover": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "textTag": {
      "type": "string",
      "default": "span"
    },
    "textStroke": {
      "type": "object",
      "default": {
        "width": {
          "desktop": {
            "value": "",
            "unit": "px"
          },
          "tablet": {},
          "mobile": {}
        },
        "color": {
          "light": "",
          "dark": ""
        },
        "enabled": false
      }
    },
    "textShadow": {
      "type": "object",
      "default": {
        "horizontal": "0",
        "vertical": "0",
        "blur": "0",
        "color": {
          "light": "",
          "dark": ""
        },
        "enabled": false
      }
    },
    "blendMode": {
      "type": "string",
      "default": ""
    },
    "dividerSize": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "40",
          "unit": "px"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "dividerColor": {
      "type": "object",
      "default": {
        "light": "",
        "dark": ""
      }
    },
    "dividerRotate": {
      "type": "number",
      "default": 30
    },
    "spacing": {
      "type": "object",
      "default": {
        "desktop": {
          "padding": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          },
          "margin": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "advancedLayout": {
      "type": "object",
      "default": {
        "desktop": {
          "overflow": "clip"
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "background": {
      "type": "object",
      "default": {
        "type": "none",
        "color": {
          "light": "",
          "dark": ""
        },
        "gradient": {
          "light": "",
          "dark": ""
        },
        "image": {
          "url": "",
          "id": null,
          "position": "center center",
          "repeat": "no-repeat",
          "size": "cover",
          "attachment": "scroll"
        },
        "overlay": {
          "enabled": false,
          "color": {
            "light": "",
            "dark": ""
          },
          "opacity": 0.5
        }
      }
    },
    "border": {
      "type": "object",
      "default": {
        "desktop": {
          "style": "",
          "width": {
            "top": "",
            "right": "",
            "bottom": "",
            "left": "",
            "unit": "px"
          },
          "color": {
            "light": "",
            "dark": ""
          },
          "radius": {
            "topLeft": "",
            "topRight": "",
            "bottomRight": "",
            "bottomLeft": "",
            "unit": "px"
          }
        },
        "tablet": {},
        "mobile": {}
      }
    },
    "borderHover": {
      "type": "object",
      "default": {
        "desktop": {},
        "tablet": {},
        "mobile": {}
      }
    },
    "boxShadow": {
      "type": "object",
      "default": {
        "horizontal": "0",
        "vertical": "4",
        "blur": "6",
        "spread": "0",
        "color": {
          "light": "rgba(0, 0, 0, 0.1)",
          "dark": ""
        },
        "inset": false,
        "enabled": false
      }
    },
    "boxShadowHover": {
      "type": "object",
      "default": {
        "horizontal": "0",
        "vertical": "4",
        "blur": "6",
        "spread": "0",
        "color": {
          "light": "rgba(0, 0, 0, 0.1)",
          "dark": ""
        },
        "inset": false,
        "enabled": false
      }
    },
    "animation": {
      "type": "object",
      "default": {
        "type": "",
        "duration": 400,
        "delay": 0,
        "easing": "ease",
        "once": true
      }
    },
    "responsiveVisibility": {
      "type": "object",
      "default": {
        "hideOnDesktop": false,
        "hideOnTablet": false,
        "hideOnMobile": false
      }
    },
    "htmlAttributes": {
      "type": "object",
      "default": {
        "customAttributes": []
      }
    }
  },
  "supports": {
    "anchor": true,
    "className": true,
    "html": false
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}